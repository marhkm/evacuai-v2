{
  "name": "evacuai",
  "private": true,
  "workspaces": [
    "packages/*",
    "mobile"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.base.json",
    "validate": "tsx packages/routing/src/cli/validate.ts campus-data/demo campus-data/uclm",
    "snapshots": "tsx packages/routing/src/cli/snapshot.ts campus-data/demo campus-data/uclm",
    "build:3d": "vite build --config packages/campus-3d/vite.config.ts --logLevel warn",
    "e2e": "playwright test",
    "manual": "node scripts/build-manual.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "fast-check": "^4.10.2",
    "marked": "^18.0.14",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
