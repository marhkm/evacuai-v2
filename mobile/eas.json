{
  "cli": {
    "version": ">= 24.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_SHOW_SERVER_SETTING": "true",
        "EXPO_PUBLIC_API_URL": "https://evacuai.tech"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_SHOW_SERVER_SETTING": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
