# LOCAL TESTING ONLY. These keys are public. Production must generate its own
# (php artisan key:generate --show, and new REVERB_APP_KEY/SECRET values).
APP_NAME=EvacuAI
APP_ENV=local
APP_DEBUG=true
APP_KEY=base64:dXUBEXgWkQwYDAVWazdHdZqm+nhv5jq+u+KnVigHlUw=
APP_URL=http://localhost:8000
SEED_DEMO=true

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=evacuai
DB_USERNAME=evacuai
DB_PASSWORD=evacuai

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database
BROADCAST_CONNECTION=reverb

# Server side publishes to the reverb container; browsers/phones connect to localhost or your LAN IP.
REVERB_APP_ID=100001
REVERB_APP_KEY=e3564eaeb296d4f7a7b1651c39e7274b
REVERB_APP_SECRET=d70239d40a5551513865ad73404198a8
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY=e3564eaeb296d4f7a7b1651c39e7274b
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS="no-reply@evacuai.test"
MAIL_FROM_NAME=EvacuAI

# Empty = allow any email domain (local). Production: comma-separated UCLM domains.
ALLOWED_EMAIL_DOMAINS=
# Optional Google sign-in (testing OAuth client only).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Microsoft 365 sign-in: only accounts from this Entra tenant (UCLM's) can sign in.
# The client id is an Entra "Single-page application" registration with redirect http://localhost:8081.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=

# Optional hazard feeds: USGS earthquakes + Open-Meteo rainfall near campus create DRAFT alerts for officers.
# FEEDS_FAKE=true reads built-in classroom samples instead of the internet.
FEEDS_ENABLED=false
FEEDS_FAKE=false
CAMPUS_LAT=
CAMPUS_LNG=

# Optional AI translation of alerts (Cebuano / Filipino), reviewed by the officer before broadcast.
# Tried in order: Gemini, Groq, local Ollama (docker compose --profile ai-local up; then OLLAMA_URL=http://ollama:11434).
# Free tiers may use prompts for training: only the alert text is sent, never names or contact details.
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_URL=

# Optional SMS alerts through Semaphore (paid per message). Empty = off.
SEMAPHORE_API_KEY=

# Data Privacy Act: days before IP addresses, location history and closed reports' photos are deleted.
PRIVACY_RETENTION_DAYS=30
